      <rect x="27" y="50" width="11" height="4" fill="#25222b" />
    </g>
  </svg>
</aside>

<style>
  .pixel-companion {
    position: fixed;
    z-index: 25;
    right: 1.1rem;
    bottom: 1rem;
    width: 52px;
    filter: drop-shadow(3px 3px 0 rgba(37, 34, 43, 0.3));
    transition: top 0.9s steps(6), right 0.9s steps(6), bottom 0.9s steps(6), left 0.9s steps(6), transform 0.18s steps(2);
  }

  .pixel-companion:hover {
    transform: translateY(-6px);
  }

  .pixel-companion svg {
    display: block;
    width: 100%;
    image-rendering: pixelated;
    animation: companion-bob 2.2s steps(2) infinite;
  }

  .pixel-companion-bubble {
    position: absolute;
    right: 2.5rem;
    bottom: 3.2rem;
    width: max-content;
    max-width: 12rem;
    padding: 0.55rem 0.7rem;
    border: 2px solid var(--pixel-ink);
    background: var(--pixel-card);
    box-shadow: 3px 3px 0 var(--pixel-shadow);
    color: var(--pixel-ink);
    font-family: var(--pixel-font);
    font-size: 0.9rem;
    font-weight: 700;
    opacity: 1;
    transition: opacity 0.15s;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .pixel-companion-bubble b {
    color: var(--pixel-purple-dark);
    font-size: 0.78rem;
    animation: companion-arrow 1s steps(2) infinite;
  }

  .pixel-companion-bubble:hover { background: var(--pixel-yellow); color: #25222b; }
  .pixel-companion-bubble:hover b { color: #4e359f; }
  .pixel-companion-bubble:hover::after { background: var(--pixel-yellow); }
  .pixel-companion-bubble:focus-visible { outline: 3px solid var(--pixel-purple); outline-offset: 3px; }

  .pixel-companion-bubble::after {
    content: "";
    position: absolute;
    right: -7px;
    bottom: 6px;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--pixel-ink);
    border-bottom: 2px solid var(--pixel-ink);
    background: var(--pixel-card);
    transform: rotate(-45deg);
  }

  .pixel-companion[data-position="middle-right"] { top: 42%; right: 1.1rem; bottom: auto; left: auto; }
  .pixel-companion[data-position="bottom-left"] { right: auto; bottom: 1rem; left: 1.1rem; }
  .pixel-companion[data-position="middle-left"] { top: 42%; right: auto; bottom: auto; left: 1.1rem; }

  .pixel-companion[data-position$="left"] .pixel-companion-bubble {
    right: auto;
    left: 2.5rem;
  }

  .pixel-companion[data-position$="left"] .pixel-companion-bubble::after {
    right: auto;
    left: -7px;
    border-right: 0;
    border-bottom: 0;
    border-left: 2px solid var(--pixel-ink);
    border-top: 2px solid var(--pixel-ink);
  }

  @keyframes companion-bob {
    50% { transform: translateY(-3px); }
  }

  @keyframes companion-arrow {
    50% { transform: translate(2px, -2px); }
  }

  @media (max-width: 640px) {
    .pixel-companion { right: 0.6rem; bottom: 0.6rem; width: 44px; }
    .pixel-companion[data-position="middle-right"] { top: 48%; right: 0.6rem; }
    .pixel-companion[data-position="bottom-left"] { bottom: 0.6rem; left: 0.6rem; }
    .pixel-companion[data-position="middle-left"] { top: 48%; left: 0.6rem; }
    .pixel-companion-bubble { max-width: 10.5rem; padding: 0.55rem 0.65rem; font-size: 0.82rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pixel-companion svg,
    .pixel-companion-bubble b { animation: none; }
  }
</style>

<script>
  const companionMessages = [
    { text: "hey, explore around! ✦", href: "/#projects" },
    { text: "hey, check out speaking!", href: "/#talks" },
    { text: "hey, see what I’ve shipped!", href: "/#projects" },
    { text: "hey, read my latest notes!", href: "/#writing" },
    { text: "hey, visit Beyond Work!", href: "/#beyond-work" },
    { text: "hey, check out About!", href: "/about" },
    { text: "hey, thank you for visiting! 💜", href: "/about" },
  ];

  const companionPositions = ["bottom-right", "middle-right", "bottom-left", "middle-left"];
  const mobileCompanionPositions = ["bottom-right", "bottom-left"];

  function initPixelCompanion() {
    const companion = document.querySelector<HTMLElement>(".pixel-companion");
    const bubble = companion?.querySelector<HTMLAnchorElement>("[data-companion-message]");
    const message = bubble?.querySelector<HTMLElement>("[data-companion-text]");
    if (!companion || !bubble || !message) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let messageIndex = 0;
    let positionIndex = 0;

    window.clearInterval((window as typeof window & { pixelCompanionTimer?: number }).pixelCompanionTimer);

    const updateCompanion = () => {
      messageIndex = (messageIndex + 1 + Math.floor(Math.random() * (companionMessages.length - 1))) % companionMessages.length;
      message.textContent = companionMessages[messageIndex].text;
      bubble.setAttribute("href", companionMessages[messageIndex].href);
      bubble.setAttribute("aria-label", companionMessages[messageIndex].text);

      if (!reducedMotion) {
        const positions = window.innerWidth <= 640 ? mobileCompanionPositions : companionPositions;
        positionIndex = (positionIndex + 1 + Math.floor(Math.random() * (positions.length - 1))) % positions.length;
        companion.dataset.position = positions[positionIndex];
      }
    };

    (window as typeof window & { pixelCompanionTimer?: number }).pixelCompanionTimer = window.setInterval(updateCompanion, 5000);
  }

  initPixelCompanion();
  document.addEventListener("astro:page-load", initPixelCompanion);
</script>
