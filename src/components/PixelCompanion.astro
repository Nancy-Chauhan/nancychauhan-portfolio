    <b aria-hidden="true">↗</b>
  </a>
  <svg viewBox="0 0 48 56" role="img" aria-label="Pixel avatar of Nancy">
    <g shape-rendering="crispEdges">
      {/* Curly hair */}
      <rect x="14" y="2" width="7" height="5" fill="#25222b" />
      <rect x="20" y="0" width="9" height="6" fill="#25222b" />
      <rect x="28" y="3" width="7" height="5" fill="#25222b" />
