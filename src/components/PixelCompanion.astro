      <rect x="6" y="10" width="8" height="9" fill="#25222b" />
      <rect x="35" y="9" width="7" height="10" fill="#25222b" />
      <rect x="7" y="18" width="7" height="10" fill="#25222b" />
      <rect x="36" y="18" width="6" height="11" fill="#25222b" />
      <rect x="10" y="25" width="6" height="7" fill="#25222b" />
      <rect x="34" y="26" width="6" height="7" fill="#25222b" />
      <rect x="13" y="12" width="22" height="16" fill="#cf8467" />
      {/* Glasses */}
      <rect x="15" y="15" width="8" height="2" fill="#25222b" />
      <rect x="15" y="21" width="8" height="2" fill="#25222b" />
      <rect x="15" y="15" width="2" height="8" fill="#25222b" />
      <rect x="21" y="15" width="2" height="8" fill="#25222b" />
      <rect x="27" y="15" width="8" height="2" fill="#25222b" />
      <rect x="27" y="21" width="8" height="2" fill="#25222b" />
      <rect x="27" y="15" width="2" height="8" fill="#25222b" />
      <rect x="33" y="15" width="2" height="8" fill="#25222b" />
      <rect x="23" y="18" width="4" height="2" fill="#25222b" />
      <rect x="18" y="18" width="2" height="2" fill="#f3ede4" />
      <rect x="30" y="18" width="2" height="2" fill="#f3ede4" />
      <rect x="20" y="24" width="9" height="2" fill="#7d3547" />
      <rect x="17" y="28" width="14" height="4" fill="#cf8467" />
      <rect x="11" y="32" width="26" height="4" fill="#7557d9" />
      <rect x="7" y="36" width="34" height="14" fill="#7557d9" />
      <rect x="11" y="36" width="4" height="14" fill="#81b8f2" />
      <rect x="23" y="36" width="4" height="14" fill="#81b8f2" />
      <rect x="35" y="36" width="4" height="14" fill="#81b8f2" />
      <rect x="4" y="38" width="5" height="10" fill="#cf8467" />
      <rect x="39" y="38" width="5" height="10" fill="#cf8467" />
