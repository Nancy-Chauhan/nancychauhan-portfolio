---
const skillGroups = [
  {
    category: "Languages",
    mark: ">_",
    skills: [
      { name: "Python", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg" },
      { name: "TypeScript", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg" },
      { name: "Go", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/go/go-original.svg" },
      { name: "Java", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg" },
      { name: "SQL", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg" },
    ],
  },
  {
    category: "AI & ML",
    mark: "✦",
    skills: [
      { name: "LLM Observability" },
      { name: "AI Agents" },
      { name: "RAG" },
      { name: "Prompt Engineering" },
    ],
  },
  {
    category: "Infrastructure",
    mark: "⌁",
    skills: [
      { name: "Kubernetes", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kubernetes/kubernetes-original.svg" },
      { name: "Docker", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg" },
      { name: "Terraform", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/terraform/terraform-original.svg" },
      { name: "AWS", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/amazonwebservices/amazonwebservices-original-wordmark.svg" },
      { name: "GCP", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/googlecloud/googlecloud-original.svg" },
    ],
  },
  {
    category: "Security",
    mark: "[#]",
    skills: [
      { name: "CI/CD Security" },
      { name: "SAST" },
      { name: "Vulnerability Mgmt" },
      { name: "DevSecOps" },
    ],
  },
  {
    category: "Developer Relations",
    mark: "))",
    skills: [
      { name: "Technical Writing" },
      { name: "Conference Speaking" },
      { name: "Community Building" },
      { name: "Developer Education" },
    ],
  },
  {
    category: "Frameworks & Tools",
    mark: "◆",
    skills: [
      { name: "React", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg" },
      { name: "Next.js", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nextjs/nextjs-original.svg" },
      { name: "FastAPI", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/fastapi/fastapi-original.svg" },
      { name: "Node.js", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg" },
      { name: "Git", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/git/git-original.svg" },
    ],
  },
];
---

<section id="tech-stack">
  <div class="stack-heading animate-on-scroll">
    <div>
      <p class="stack-kicker">TOOLKIT.exe</p>
      <h2 class="text-3xl md:text-4xl font-extrabold font-sans tracking-tight">
        <span class="section-heading">Tech Stack</span>
      </h2>
    </div>
    <p class="stack-intro">Open a category to see the tools and practices behind my work.</p>
  </div>
  <div class="skills-grid">
    {skillGroups.map((group, i) => (
      <details class={`animate-on-scroll stagger-${i + 1} skill-card`}>
        <summary class="skill-card__header">
          <span class="skill-card__number">0{i + 1}</span>
          <span class="skill-card__mark" aria-hidden="true">{group.mark}</span>
          <h3>{group.category}</h3>
          <span class="skill-card__count">{group.skills.length}</span>
          <span class="skill-card__toggle" aria-hidden="true"></span>
        </summary>
        <div class="skill-card__body">
          {group.skills.map((skill) => (
            <span class="skill-tag">
              {skill.logo && (
                <img src={skill.logo} alt="" class="skill-logo" loading="lazy" />
              )}
              {skill.name}
            </span>
          ))}
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .stack-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .stack-kicker {
    margin-bottom: 0.45rem;
    color: var(--pixel-purple);
    font-family: var(--pixel-font);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }

  .stack-intro {
    max-width: 31rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .skill-card {
    --skill-accent: #7656e8;
    --skill-tint: #e8e0ff;
    overflow: hidden;
    background: #fffaf1;
    border: 3px solid var(--color-stone-800);
    box-shadow: 7px 7px 0 var(--pixel-shadow);
    transition: transform 0.2s steps(2), box-shadow 0.2s steps(2);
  }

  .skill-card:nth-child(2) { --skill-accent: #2875d2; --skill-tint: #dcecff; }
  .skill-card:nth-child(3) { --skill-accent: #148b68; --skill-tint: #d9f5e9; }
  .skill-card:nth-child(4) { --skill-accent: #db3f80; --skill-tint: #ffe0ed; }
  .skill-card:nth-child(5) { --skill-accent: #c06a18; --skill-tint: #ffebc8; }
  .skill-card:nth-child(6) { --skill-accent: #7656e8; --skill-tint: #e8e0ff; }

  .skill-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 10px 10px 0 var(--pixel-shadow);
  }

  .skill-card__header {
    display: grid;
    grid-template-columns: auto auto 1fr auto auto;
    align-items: center;
    gap: 0.8rem;
    min-height: 4.2rem;
    padding: 0.8rem 1rem;
    background: var(--skill-tint);
    cursor: pointer;
    list-style: none;
  }

  .skill-card__header::-webkit-details-marker { display: none; }
  .skill-card[open] .skill-card__header { border-bottom: 3px solid var(--color-stone-800); }

  .skill-card__number,
  .skill-card__count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .skill-card__toggle {
    position: relative;
    width: 1.2rem;
    height: 1.2rem;
  }

  .skill-card__toggle::before,
  .skill-card__toggle::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.9rem;
    height: 2px;
    background: var(--skill-accent);
    transform: translate(-50%, -50%);
  }

  .skill-card__toggle::after { transform: translate(-50%, -50%) rotate(90deg); }
  .skill-card[open] .skill-card__toggle::after { display: none; }

  .skill-card__number { color: var(--skill-accent); }

  .skill-card__mark {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    color: white;
    background: var(--skill-accent);
    border: 2px solid var(--color-stone-800);
    font-family: var(--pixel-font);
    font-size: 0.9rem;
    box-shadow: 3px 3px 0 var(--pixel-shadow);
  }

  .skill-card h3 {
    font-family: var(--pixel-font);
    font-size: 1rem;
    line-height: 1.15;
  }

  .skill-card__count {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    color: var(--color-stone-600);
    background: #fffaf1;
    border: 2px solid var(--color-stone-800);
  }

  .skill-card__body {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 0.65rem;
    padding: 1.25rem;
    animation: reveal-skills 0.18s ease-out;
  }

  @keyframes reveal-skills {
    from { opacity: 0; transform: translateY(-0.35rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  .skill-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 650;
    color: var(--color-stone-800);
    background: white;
    border: 2px solid var(--color-stone-800);
    box-shadow: 3px 3px 0 color-mix(in srgb, var(--skill-accent) 35%, transparent);
    transition: transform 0.15s steps(2), background 0.15s steps(2);
  }

  .skill-tag:hover {
    transform: translateY(-2px);
    background: var(--skill-tint);
  }

  .skill-logo {
    width: 1.1rem;
    height: 1.1rem;
    object-fit: contain;
  }

  @media (max-width: 767px) {
    .stack-heading {
      display: block;
    }

    .stack-intro {
      margin-top: 0.75rem;
    }

    .skills-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .skill-card {
      box-shadow: 5px 5px 0 var(--pixel-shadow);
    }

    .skill-card__header {
      grid-template-columns: auto auto 1fr auto auto;
      gap: 0.6rem;
      padding-inline: 0.8rem;
    }

    .skill-card__body {
      padding: 1rem;
    }
  }

  :global(html[data-theme="dark"]) .skill-card {
    --skill-accent: #9089ff;
    --skill-tint: #2f2947;
    background: var(--pixel-card);
  }

  :global(html[data-theme="dark"]) .skill-card:nth-child(2) { --skill-accent: #7eb8ff; --skill-tint: #203b59; }
  :global(html[data-theme="dark"]) .skill-card:nth-child(3) { --skill-accent: #72d7a5; --skill-tint: #1b4439; }
  :global(html[data-theme="dark"]) .skill-card:nth-child(4) { --skill-accent: #ff8fbd; --skill-tint: #502b40; }
  :global(html[data-theme="dark"]) .skill-card:nth-child(5) { --skill-accent: #ffbd75; --skill-tint: #51371f; }
  :global(html[data-theme="dark"]) .skill-card:nth-child(6) { --skill-accent: #9089ff; --skill-tint: #2f2947; }

  :global(html[data-theme="dark"]) .skill-card__mark { color: #15131b; }
  :global(html[data-theme="dark"]) .skill-card__count,
  :global(html[data-theme="dark"]) .skill-tag { background: #111827; }

  @media (prefers-reduced-motion: reduce) {
    .skill-card__body { animation: none; }
  }
</style>
