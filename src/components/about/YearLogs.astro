---
import { getCollection } from "astro:content";

const yearLogs = (await getCollection("blog"))
  .filter((post) => post.data.tags.includes("year-in-review") && post.data.externalUrl)
  .sort((first, second) => second.data.pubDate.getTime() - first.data.pubDate.getTime());
---

<section id="year-logs">
  <div class="year-logs-heading animate-on-scroll">
    <div>
      <p class="year-logs-kicker">LIFE_LOGS/</p>
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">
        <span class="section-heading">Thank You, Next</span>
      </h2>
    </div>
    <p>One honest reflection at the end of every year.</p>
  </div>

  <div class="year-logs-grid">
    {yearLogs.map((post, index) => (
      <a
        href={post.data.externalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class={`year-log animate-on-scroll stagger-${index + 1}`}
        aria-label={`Read ${post.data.title} on Medium`}
      >
        <div class="year-log-image">
          <img src={post.data.image} alt="" loading="lazy" />
          <span class="year-log-number">0{index + 1}</span>
        </div>
        <div class="year-log-content">
          <strong>{post.data.pubDate.getFullYear()}</strong>
          <span class="year-log-name">{post.data.title}</span>
          <b aria-hidden="true">↗</b>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .year-logs-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .year-logs-heading > p {
    max-width: 24rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .year-logs-kicker {
    margin-bottom: 0.45rem;
    color: var(--pixel-purple);
    font-family: var(--pixel-font);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }

  .year-logs-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .year-log {
    position: relative;
    display: block;
    overflow: hidden;
    border: 2px solid var(--pixel-ink);
    background: var(--pixel-card);
    box-shadow: 4px 4px 0 var(--pixel-shadow);
    color: var(--pixel-ink);
    transition: transform 0.12s steps(2), box-shadow 0.12s steps(2);
  }

  .year-log-image {
    position: relative;
    height: 8rem;
    overflow: hidden;
    border-bottom: 2px solid var(--pixel-ink);
    background: var(--pixel-lilac);
  }

  .year-log-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .year-log:hover .year-log-image img { transform: scale(1.04); }

  .year-log-content {
    position: relative;
    display: grid;
    gap: 0.25rem;
    padding: 0.85rem;
  }

  .year-log:hover {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 var(--pixel-shadow);
  }

  .year-log-number {
    position: absolute;
    left: 0.6rem;
    top: 0.6rem;
    padding: 0.25rem 0.35rem;
    border: 2px solid var(--pixel-ink);
    background: var(--pixel-yellow);
    color: var(--pixel-purple);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .year-log strong {
    color: var(--pixel-purple-dark);
    font-family: var(--pixel-font);
    font-size: 1.8rem;
  }

  .year-log-name {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .year-log b {
    position: absolute;
    right: 0.8rem;
    top: 0.85rem;
    color: var(--pixel-peach);
  }

  @media (max-width: 767px) {
    .year-logs-heading { display: block; }
    .year-logs-heading > p { margin-top: 0.75rem; }
    .year-logs-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .year-log-image { height: 7.5rem; }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .year-logs-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .year-log-image img { transition: none; }
  }
</style>
