---
import { profile } from "../../data/profile";

const { currentRole, previousRoles } = profile;
---

<section>
  <h2 class="text-3xl md:text-4xl font-extrabold font-sans tracking-tight mb-8 animate-on-scroll">
    <span class="section-heading">Work</span>
  </h2>

  {/* Current role — always visible */}
  <div class="animate-on-scroll card-brutal p-6 mb-4">
    <div class="flex items-start gap-4">
      <div class="relative shrink-0 w-3 h-3 mt-2 rounded-full bg-[var(--color-purple)] border-2 border-white"></div>
      <div class="flex-1">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-1">
          <h3 class="text-lg font-bold font-sans text-[var(--color-stone-900)] flex items-center gap-2">
              <img src="/logos/arize.svg" alt="Arize AI" class="h-5" />
            </h3>
          <div class="flex items-center gap-2">
            <span class="font-sans text-sm text-[var(--color-stone-400)]">{currentRole.period}</span>
          </div>
        </div>
        <p class="font-sans text-sm text-[var(--color-purple)] mb-1">{currentRole.role}</p>
        <p class="text-base font-sans text-[var(--color-stone-500)] leading-relaxed">{currentRole.description}</p>
        <p class="text-sm font-sans text-[var(--color-stone-400)] mt-1">{currentRole.location}</p>
      </div>
    </div>
  </div>

  {/* Previous roles — collapsible */}
  <details class="group animate-on-scroll">
    <summary class="cursor-pointer list-none inline-flex items-center gap-2 px-4 py-2.5 border-2 border-[var(--color-stone-300)] bg-[var(--color-stone-50)] font-sans text-sm font-semibold text-[var(--color-stone-600)] hover:border-[var(--color-purple)] hover:text-[var(--color-purple)] transition-colors select-none">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
      Previous roles
      <span class="inline-flex items-center justify-center w-5 h-5 text-xs bg-[var(--color-stone-200)] text-[var(--color-stone-500)] rounded-full">{previousRoles.length}</span>
    </summary>

    <div class="relative mt-4 space-y-3">
      {/* Dashed vertical connector line */}
      <div class="absolute left-[1.625rem] top-4 bottom-4 w-0 border-l-2 border-dashed border-[var(--color-stone-300)]"></div>
      {previousRoles.map((item, i) => (
        <div class={`card-dashed p-5`}>
          <div class="flex items-start gap-4">
            <div class="relative shrink-0 w-3 h-3 mt-2 rounded-full bg-[var(--color-purple)] opacity-40 border-2 border-white"></div>
            <div class="flex-1">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-1">
                <h3 class="text-base font-bold font-sans text-[var(--color-stone-900)]">{item.company}</h3>
                <span class="font-sans text-sm text-[var(--color-stone-400)]">{item.period}</span>
              </div>
              <p class="font-sans text-sm text-[var(--color-purple)] mb-1">{item.role}</p>
              <p class="text-sm font-sans text-[var(--color-stone-500)] leading-relaxed">{item.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </details>
</section>
