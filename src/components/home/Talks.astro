---
const talksData = await import("../../data/talks/talks.json");
const talks = talksData.default as {
  title: string; event: string; year: number; type: string; video?: string; coSpeaker?: string;
}[];

// Only show talks with videos, sorted by year descending
const videoTalks = talks
  .filter((t) => t.video)
  .sort((a, b) => b.year - a.year);

// Extract YouTube video ID from URL
function getYouTubeId(url: string) {
  const match = url.match(/(?:v=|\/)([\w-]{11})/);
  return match ? match[1] : null;
}

---

<section id="talks">
  <div class="mb-10 animate-on-scroll">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <h2 class="text-3xl md:text-4xl font-extrabold font-sans tracking-tight mb-3">
          <span class="section-heading">I Talk Tech at Conferences</span>
        </h2>
        <p class="text-lg text-[var(--color-stone-500)] font-sans">
          Sharing ideas on stage, from meetups to global events.
        </p>
      </div>
      <div class="hidden sm:block shrink-0">
        <a
          href="https://www.youtube.com/playlist?list=PL-0wUDKSiP4rYhEiKlOQQ433nh1KxCOx1"
          target="_blank" rel="noopener noreferrer"
          class="btn-brutal btn-brutal-secondary text-sm"
        >
          All talks
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  {/* Mobile: horizontal scroll */}
  <div class="sm:hidden">
  <div id="talks-carousel-mobile" class="flex gap-4 overflow-x-auto scroll-smooth no-scrollbar">
    {videoTalks.slice(0, 6).map((talk) => talk.video && (
      <article class="shrink-0 w-[260px] card-brutal overflow-hidden flex flex-col">
        <button
          type="button"
          data-talk-video={getYouTubeId(talk.video)}
          data-talk-title={talk.title}
          class="talk-video-trigger group relative w-full overflow-hidden"
          aria-label={`Play ${talk.title}`}
        >
          <img
            src={`https://img.youtube.com/vi/${getYouTubeId(talk.video)}/maxresdefault.jpg`}
            alt={talk.title}
            class="w-full aspect-video object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
          />
          <span class="talk-play-icon" aria-hidden="true"><span></span></span>
        </button>
        <div class="p-3">
          <p class="font-sans font-bold text-[var(--text-primary)] text-xs leading-snug">{talk.title}</p>
        </div>
      </article>
    ))}
  </div>
  <p class="flex items-center justify-end gap-1 mt-3 font-mono text-xs text-[var(--text-muted)]">
    swipe
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
  </p>
  </div>

  {/* Desktop: grid */}
  <div class="hidden sm:grid sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-5">
    {videoTalks.slice(0, 6).map((talk, i) => talk.video && (
      <article class={`animate-on-scroll stagger-${i + 1} card-brutal w-full overflow-hidden flex flex-col`}>
        <button
          type="button"
          data-talk-video={getYouTubeId(talk.video)}
          data-talk-title={talk.title}
          class="talk-video-trigger group relative w-full overflow-hidden"
          aria-label={`Play ${talk.title}`}
        >
          <img
            src={`https://img.youtube.com/vi/${getYouTubeId(talk.video)}/maxresdefault.jpg`}
            alt={talk.title}
            class="w-full aspect-video object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
          />
          <span class="talk-play-icon" aria-hidden="true"><span></span></span>
        </button>
        <div class="p-3">
          <p class="font-sans font-bold text-[var(--text-primary)] text-xs leading-snug">{talk.title}</p>
        </div>
      </article>
    ))}
  </div>

  <div class="mt-8 text-center sm:hidden">
    <a
      href="https://www.youtube.com/playlist?list=PL-0wUDKSiP4rYhEiKlOQQ433nh1KxCOx1"
      target="_blank" rel="noopener noreferrer"
      class="inline-flex btn-brutal btn-brutal-secondary text-sm"
    >
      All talks
    </a>
  </div>

</section>

<style>
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .talk-video-trigger { display: block; background: #050816; }
  .talk-play-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    border: 3px solid white;
    border-radius: 50%;
    background: rgba(37, 34, 43, 0.78);
    box-shadow: 4px 4px 0 rgba(37, 34, 43, 0.55);
    transform: translate(-50%, -50%);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .talk-play-icon span {
    width: 0;
    height: 0;
    margin-left: 0.25rem;
    border-top: 0.7rem solid transparent;
    border-bottom: 0.7rem solid transparent;
    border-left: 1.05rem solid white;
  }
  .talk-video-trigger:hover .talk-play-icon { background: var(--pixel-purple); transform: translate(-50%, -50%) scale(1.08); }
  :global(.talk-inline-player) { aspect-ratio: 16 / 9; background: #050816; }
  :global(.talk-inline-player iframe) { display: block; width: 100%; height: 100%; border: 0; }
</style>

<script>
  function bindTalkPlayer() {
    document.querySelectorAll<HTMLButtonElement>("[data-talk-video]").forEach((button) => {
      if (button.dataset.talkBound) return;
      button.dataset.talkBound = "true";
      button.addEventListener("click", () => {
        const videoId = button.dataset.talkVideo;
        if (!videoId) return;
        const player = document.createElement("div");
        player.className = "talk-inline-player";
        const iframe = document.createElement("iframe");
        iframe.title = button.dataset.talkTitle || "Conference talk video";
        iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        player.append(iframe);
        button.replaceWith(player);
      });
    });
  }

  bindTalkPlayer();
  document.addEventListener("astro:page-load", bindTalkPlayer);
</script>
