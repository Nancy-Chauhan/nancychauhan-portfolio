---
const talksData = await import("../../data/talks/talks.json");
const talks = talksData.default as {
  title: string; event: string; year: number; date?: string; type: string; video?: string; coSpeaker?: string; homeOrder?: number; unavailable?: boolean; noEmbed?: boolean; highlight?: { label: string; photo: string; post?: string };
}[];

interface Props {
  limit?: number;
  homepage?: boolean;
  variant?: "talks" | "webinars";
}

const { limit, homepage = false, variant = "talks" } = Astro.props;

// Webinars and explainer videos get their own section; conference talks stay separate.
const isWebinar = (t: (typeof talks)[number]) => t.type === "Webinar" || t.type === "Explainer";
const pool = talks.filter((t) => t.video && (variant === "webinars" ? isWebinar(t) : !isWebinar(t)));
const newestFirst = (a: (typeof talks)[number], b: (typeof talks)[number]) =>
  b.year - a.year || (b.date ?? "").localeCompare(a.date ?? "");

// Homepage uses the hand-picked homeOrder; elsewhere, newest first.
const videoTalks = homepage
  ? pool.filter((t) => t.homeOrder).sort((a, b) => a.homeOrder! - b.homeOrder!)
  : pool.sort(newestFirst);

const copy = variant === "webinars"
  ? {
      id: "webinars",
      heading: "Webinars & Explainers",
      sub: "Hands-on sessions breaking down how to build, test and run AI agents in production.",
      cta: null,
    }
  : {
      id: "talks",
      heading: "I Talk Tech at Conferences",
      sub: "Sharing ideas on stage, from meetups to global events.",
      cta: "https://www.youtube.com/playlist?list=PL-0wUDKSiP4rYhEiKlOQQ433nh1KxCOx1",
    };
const shownTalks = videoTalks.slice(0, limit ?? videoTalks.length);
// The full list (speaking page) uses the grid at every width; the homepage keeps the mobile carousel.
const showAll = !homepage && limit === undefined;
// On the full list, one talk can be promoted to a large highlight card (e.g. a keynote).
const highlight = showAll ? shownTalks.find((t) => t.highlight) : undefined;
const gridTalks = highlight ? shownTalks.filter((t) => t !== highlight) : shownTalks;
// Conference talks: recent ones up front, 2019–2023 tucked behind a toggle (nothing removed).
const RECENT_FROM = 2024;
const earlierTalks = variant === "talks" ? gridTalks.filter((t) => t.year < RECENT_FROM) : [];
const earlierYears = earlierTalks.map((t) => t.year);
const talkGroups = [
  { talks: gridTalks.filter((t) => !earlierTalks.includes(t)), collapsed: false, label: "" },
  { talks: earlierTalks, collapsed: true, label: earlierTalks.length ? `Show earlier talks (${Math.min(...earlierYears)}–${Math.max(...earlierYears)})` : "" },
];

// Extract YouTube video ID from URL
function getYouTubeId(url: string) {
  const match = url.match(/(?:v=|\/)([\w-]{11})/);
  return match ? match[1] : null;
}

---

<section id={copy.id}>
  <div class="mb-10 animate-on-scroll">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <h2 class="text-3xl md:text-4xl font-extrabold font-sans tracking-tight mb-3">
          <span class="section-heading">{copy.heading}</span>
        </h2>
        <p class="text-lg text-[var(--color-stone-500)] font-sans">
          {copy.sub}
        </p>
      </div>
      {copy.cta && <div class="hidden sm:block shrink-0">
        <a
          href={copy.cta}
          target="_blank" rel="noopener noreferrer"
          class="btn-brutal btn-brutal-secondary text-sm"
        >
          All talks
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>}
    </div>
  </div>

  {/* Mobile: horizontal scroll */}
  <div class:list={["sm:hidden", showAll && "hidden"]}>
  <div id="talks-carousel-mobile" class="flex gap-4 overflow-x-auto scroll-smooth no-scrollbar">
    {shownTalks.map((talk) => talk.video && (
      <article class="shrink-0 w-[260px] card-brutal overflow-hidden flex flex-col">
        <button
          type="button"
          data-talk-video={talk.unavailable ? undefined : getYouTubeId(talk.video)}
          disabled={talk.unavailable}
          data-talk-external={talk.noEmbed ? talk.video : undefined}
          data-talk-title={talk.title}
          class="talk-video-trigger group relative w-full overflow-hidden"
          aria-label={talk.unavailable ? `${talk.title} (no longer public)` : `Play ${talk.title}`}
        >
          <img
            src={`/talks/${getYouTubeId(talk.video)}.jpg`}
            alt={talk.title}
            width="1280"
            height="720"
            class="w-full aspect-video object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
            decoding="async"
          />
          {talk.unavailable
            ? <span class="talk-gone">No longer public</span>
            : <span class="talk-play-icon" aria-hidden="true"><span></span></span>}
        </button>
        <div class="p-3">
          <p class="font-sans font-bold text-[var(--text-primary)] text-xs leading-snug">{talk.title}</p>
          {showAll && <p class="talk-meta">{talk.event} · {talk.year}</p>}
        </div>
      </article>
    ))}
  </div>
  <p class="flex items-center justify-end gap-1 mt-3 font-mono text-xs text-[var(--text-muted)]">
    swipe
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
  </p>
  </div>

  {showAll ? (
    <>
    {highlight && highlight.video && (
      <article class="talk-highlight card-brutal animate-on-scroll">
        <button
          type="button"
          data-talk-video={getYouTubeId(highlight.video)}
          data-talk-title={highlight.title}
          class="talk-video-trigger highlight-photo group relative w-full overflow-hidden"
          aria-label={`Play ${highlight.title}`}
        >
          <img src={highlight.highlight!.photo} alt={`${highlight.title} on stage at ${highlight.event}`} width="1400" height="1050" loading="lazy" decoding="async" />
          <span class="talk-play-icon" aria-hidden="true"><span></span></span>
        </button>
        <div class="highlight-body">
          <span class="highlight-badge">★ {highlight.highlight!.label}</span>
          <h3 class="highlight-title">{highlight.title}</h3>
          <p class="highlight-meta">{highlight.event} · {highlight.year}{highlight.coSpeaker ? ` · with ${highlight.coSpeaker}` : ""}</p>
          <div class="highlight-actions">
            <button type="button" class="pixel-button pixel-button-primary text-sm" data-talk-proxy>▶ Watch the keynote</button>
            {highlight.highlight!.post && (
              <a href={highlight.highlight!.post} target="_blank" rel="noopener noreferrer" class="pixel-button pixel-button-ghost text-sm">From the stage ↗</a>
            )}
          </div>
        </div>
      </article>
    )}
    {talkGroups.map((group) => group.talks.length > 0 && (
      group.collapsed ? (
        <details class="earlier-talks">
          <summary>{group.label} <span class="earlier-count">{group.talks.length}</span></summary>
    <div class:list={["talk-list grid grid-cols-2 gap-3 sm:gap-4 md:gap-5", "md:grid-cols-3"]}>
      {group.talks.map((talk, i) => talk.video && (
              <article class={`animate-on-scroll stagger-${(i % 3) + 1} card-brutal w-full overflow-hidden flex flex-col`}>
                <button
                  type="button"
                  data-talk-video={talk.unavailable ? undefined : getYouTubeId(talk.video)}
          disabled={talk.unavailable}
          data-talk-external={talk.noEmbed ? talk.video : undefined}
                  data-talk-title={talk.title}
                  class="talk-video-trigger group relative w-full overflow-hidden"
                  aria-label={talk.unavailable ? `${talk.title} (no longer public)` : `Play ${talk.title}`}
                >
                  <img
                    src={`/talks/${getYouTubeId(talk.video)}.jpg`}
                    alt={talk.title}
                    width="1280"
                    height="720"
                    class="w-full aspect-video object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                    decoding="async"
                  />
                  {talk.unavailable
            ? <span class="talk-gone">No longer public</span>
            : <span class="talk-play-icon" aria-hidden="true"><span></span></span>}
                </button>
                <div class="p-3">
                  <p class="font-sans font-bold text-[var(--text-primary)] text-xs leading-snug">{talk.title}</p>
                  {showAll && <p class="talk-meta">{talk.event} · {talk.year}</p>}
                </div>
              </article>
      ))}
    </div>
        </details>
      ) : (
    <div class:list={["talk-list grid grid-cols-2 gap-3 sm:gap-4 md:gap-5", "md:grid-cols-3"]}>
      {group.talks.map((talk, i) => talk.video && (
              <article class={`animate-on-scroll stagger-${(i % 3) + 1} card-brutal w-full overflow-hidden flex flex-col`}>
                <button
                  type="button"
                  data-talk-video={talk.unavailable ? undefined : getYouTubeId(talk.video)}
          disabled={talk.unavailable}
          data-talk-external={talk.noEmbed ? talk.video : undefined}
                  data-talk-title={talk.title}
                  class="talk-video-trigger group relative w-full overflow-hidden"
                  aria-label={talk.unavailable ? `${talk.title} (no longer public)` : `Play ${talk.title}`}
                >
                  <img
                    src={`/talks/${getYouTubeId(talk.video)}.jpg`}
                    alt={talk.title}
                    width="1280"
                    height="720"
                    class="w-full aspect-video object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                    decoding="async"
                  />
                  {talk.unavailable
            ? <span class="talk-gone">No longer public</span>
            : <span class="talk-play-icon" aria-hidden="true"><span></span></span>}
                </button>
                <div class="p-3">
                  <p class="font-sans font-bold text-[var(--text-primary)] text-xs leading-snug">{talk.title}</p>
                  {showAll && <p class="talk-meta">{talk.event} · {talk.year}</p>}
                </div>
              </article>
      ))}
    </div>
      )
    ))}
    </>
  ) : (
  <div class:list={"hidden sm:grid sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-5"}>
    {shownTalks.map((talk, i) => talk.video && (
      <article class={`animate-on-scroll stagger-${(i % 3) + 1} card-brutal w-full overflow-hidden flex flex-col`}>
        <button
          type="button"
          data-talk-video={talk.unavailable ? undefined : getYouTubeId(talk.video)}
          disabled={talk.unavailable}
          data-talk-external={talk.noEmbed ? talk.video : undefined}
          data-talk-title={talk.title}
          class="talk-video-trigger group relative w-full overflow-hidden"
          aria-label={talk.unavailable ? `${talk.title} (no longer public)` : `Play ${talk.title}`}
        >
          <img
            src={`/talks/${getYouTubeId(talk.video)}.jpg`}
            alt={talk.title}
            width="1280"
            height="720"
            class="w-full aspect-video object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
            decoding="async"
          />
          {talk.unavailable
            ? <span class="talk-gone">No longer public</span>
            : <span class="talk-play-icon" aria-hidden="true"><span></span></span>}
        </button>
        <div class="p-3">
          <p class="font-sans font-bold text-[var(--text-primary)] text-xs leading-snug">{talk.title}</p>
          {showAll && <p class="talk-meta">{talk.event} · {talk.year}</p>}
        </div>
      </article>
    ))}
  </div>

  )}

  <div class:list={["mt-8 text-center sm:hidden", (showAll || !copy.cta) && "hidden"]}>
    <a
      href="https://www.youtube.com/playlist?list=PL-0wUDKSiP4rYhEiKlOQQ433nh1KxCOx1"
      target="_blank" rel="noopener noreferrer"
      class="inline-flex btn-brutal btn-brutal-secondary text-sm"
    >
      All talks
    </a>
  </div>

</section>

<style>
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .talk-video-trigger { display: block; background: #050816; }
  @media (max-width: 639px) {
    .talk-list .talk-play-icon { width: 2.4rem; height: 2.4rem; border-width: 2px; }
    .talk-list .talk-play-icon span { border-top-width: 0.45rem; border-bottom-width: 0.45rem; border-left-width: 0.7rem; margin-left: 0.15rem; }
    .talk-list .p-3 { padding: 0.5rem 0.55rem 0.6rem; }
    .talk-list .p-3 > p:first-child { font-size: 0.7rem; display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
    .talk-list .talk-meta { font-size: 0.58rem; }
  }
  .talk-highlight {
    display: grid;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  .highlight-photo img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 0.3s ease; }
  .highlight-photo:hover img { transform: scale(1.03); }
  .highlight-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.7rem;
    padding: 1.3rem 1.4rem 1.5rem;
  }
  .highlight-badge {
    width: fit-content;
    padding: 0.25rem 0.55rem;
    border: 2px solid var(--pixel-ink);
    background: var(--pixel-yellow);
    box-shadow: 3px 3px 0 var(--pixel-shadow);
    color: var(--pixel-ink);
    font-family: var(--pixel-font);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .highlight-title { color: var(--text-primary); font-family: var(--font-sans); font-size: clamp(1.25rem, 2.4vw, 1.75rem); font-weight: 800; line-height: 1.2; }
  .highlight-meta { color: var(--pixel-purple); font-family: var(--pixel-font); font-size: 0.8rem; font-weight: 700; }
  .highlight-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.3rem; }
  @media (min-width: 768px) {
    .talk-highlight { grid-template-columns: 1.15fr 1fr; }
    .highlight-photo { border-right: 2px solid var(--pixel-ink); }
    .highlight-photo img { height: 100%; }
  }
  @media (max-width: 767px) {
    .highlight-photo { border-bottom: 2px solid var(--pixel-ink); }
    .highlight-photo img { aspect-ratio: 16 / 10; }
    .highlight-body { padding: 0.9rem 1rem 1.1rem; gap: 0.5rem; }
    .highlight-meta { font-size: 0.68rem; }
  }
  .talk-video-trigger:disabled { cursor: default; }
  .talk-video-trigger:disabled img { filter: grayscale(1) brightness(0.6); }
  .talk-gone {
    position: absolute;
    top: 50%;
    left: 50%;
    padding: 0.3rem 0.55rem;
    border: 2px solid var(--pixel-ink);
    background: var(--pixel-card);
    color: var(--pixel-ink);
    font-family: var(--pixel-font);
    font-size: 0.7rem;
    font-weight: 700;
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }
  .earlier-talks { margin-top: 1.5rem; }
  .earlier-talks summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding: 0.55rem 0.9rem;
    border: 2px solid var(--pixel-ink);
    background: var(--pixel-card);
    box-shadow: 3px 3px 0 var(--pixel-shadow);
    cursor: pointer;
    color: var(--pixel-ink);
    font-family: var(--pixel-font);
    font-size: 0.85rem;
    font-weight: 700;
    list-style: none;
  }
  .earlier-talks summary::-webkit-details-marker { display: none; }
  .earlier-talks[open] summary { background: var(--pixel-yellow); }
  .earlier-count { padding: 0 0.35rem; border: 1.5px solid var(--pixel-ink); background: var(--pixel-yellow); font-size: 0.72rem; }
  .talk-meta {
    margin-top: 0.35rem;
    color: var(--color-stone-500);
    font-family: var(--pixel-font);
    font-size: 0.66rem;
    font-weight: 700;
  }
  .talk-play-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    border: 3px solid white;
    border-radius: 50%;
    background: rgba(37, 34, 43, 0.78);
    box-shadow: 4px 4px 0 rgba(37, 34, 43, 0.55);
    transform: translate(-50%, -50%);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .talk-play-icon span {
    width: 0;
    height: 0;
    margin-left: 0.25rem;
    border-top: 0.7rem solid transparent;
    border-bottom: 0.7rem solid transparent;
    border-left: 1.05rem solid white;
  }
  .talk-video-trigger:hover .talk-play-icon { background: var(--pixel-purple); transform: translate(-50%, -50%) scale(1.08); }
  :global(.talk-inline-player) { aspect-ratio: 16 / 9; background: #050816; }
  :global(.talk-inline-player iframe) { display: block; width: 100%; height: 100%; border: 0; }
</style>

<script>
  function bindTalkPlayer() {
    document.querySelectorAll<HTMLButtonElement>("[data-talk-video]").forEach((button) => {
      if (button.dataset.talkBound) return;
      button.dataset.talkBound = "true";
      button.addEventListener("click", () => {
        // Some owners disable embedding; open those on YouTube instead of a broken inline player.
        if (button.dataset.talkExternal) {
          window.open(button.dataset.talkExternal, "_blank", "noopener");
          return;
        }
        const videoId = button.dataset.talkVideo;
        if (!videoId) return;
        const player = document.createElement("div");
        player.className = "talk-inline-player";
        const iframe = document.createElement("iframe");
        iframe.title = button.dataset.talkTitle || "Conference talk video";
        iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        player.append(iframe);
        button.replaceWith(player);
      });
    });
  }

  function bindProxies() {
    document.querySelectorAll<HTMLButtonElement>("[data-talk-proxy]").forEach((proxy) => {
      if (proxy.dataset.proxyBound) return;
      proxy.dataset.proxyBound = "true";
      proxy.addEventListener("click", () => {
        proxy.closest(".talk-highlight")?.querySelector<HTMLButtonElement>("[data-talk-video]")?.click();
        proxy.remove();
      });
    });
  }

  bindTalkPlayer();
  bindProxies();
  document.addEventListener("astro:page-load", () => { bindTalkPlayer(); bindProxies(); });
</script>
