---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.tags?.includes("year-in-review") && !post.data.tags?.includes("personal") && !post.data.title.includes("Docker Layer Caching"))
  .sort((first, second) => second.data.pubDate.getTime() - first.data.pubDate.getTime())
  .slice(0, 3);
---

<section id="writing">
  <div class="mb-8 animate-on-scroll">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="pixel-date mb-3">RECENT_NOTES.md</p>
        <h2 class="text-3xl md:text-4xl mb-2">Ideas worth sharing</h2>
        <p class="text-base text-[var(--text-muted)]">Three recent notes on building and technology.</p>
      </div>
      <a href="https://nancy-chauhan.medium.com/" target="_blank" rel="noopener noreferrer" class="pixel-button pixel-button-ghost text-sm">
        Read all ↗
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    {posts.map((post, index) => (
      <a
        href={post.data.externalUrl || "https://nancy-chauhan.medium.com/"}
        target="_blank"
        rel="noopener noreferrer"
        class={`note-card animate-on-scroll stagger-${index + 1}`}
      >
        {post.data.image && (
          <div class="note-image">
            <img src={post.data.image} alt="" loading="lazy" />
          </div>
        )}
        <div class="note-content">
          <span class="note-number">0{index + 1}</span>
          <h3>{post.data.title}</h3>
          <div class="mt-auto flex flex-wrap gap-1.5 pt-5">
            {post.data.tags.slice(0, 2).map((tag) => <span class="tag-brutal">{tag}</span>)}
          </div>
        </div>
        <span class="note-arrow">↗</span>
      </a>
    ))}
  </div>
</section>

<style>
  .note-card {
    position: relative;
    display: flex;
    min-height: 290px;
    flex-direction: column;
    border: 2px solid var(--pixel-ink);
    background: var(--pixel-card);
    box-shadow: 4px 4px 0 var(--pixel-shadow);
    color: var(--pixel-ink);
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .note-image {
    height: 8.5rem;
    overflow: hidden;
    border-bottom: 2px solid var(--pixel-ink);
    background: var(--pixel-lilac);
  }

  .note-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .note-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1rem;
  }

  .note-card:hover {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 var(--pixel-shadow);
  }

  .note-number {
    color: var(--pixel-purple);
    font-family: var(--pixel-font);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .note-card h3 {
    max-width: 90%;
    margin-top: 0.8rem;
    color: var(--pixel-ink);
    font-family: var(--pixel-font);
    font-size: clamp(1.05rem, 1.35vw, 1.15rem);
    font-weight: 700;
    line-height: 1.35;
  }

  .note-arrow {
    position: absolute;
    right: 0.7rem;
    top: 0.7rem;
    display: grid;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border: 2px solid var(--pixel-ink);
    background: var(--pixel-yellow);
    color: var(--pixel-ink);
    font-family: var(--pixel-font);
  }

  @media (max-width: 767px) {
    .note-card { min-height: 0; }
    .note-image { height: auto; aspect-ratio: 16 / 9; }
  }
</style>
