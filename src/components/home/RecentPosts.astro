---
import { getCollection } from "astro:content";
import { isAgentNote, isPersonal } from "../../lib/posts";

interface Props {
  variant?: "agents" | "general";
}

const { variant = "general" } = Astro.props;

const allPosts = (await getCollection("blog"))
  .filter((post) => !isPersonal(post))
  .sort((first, second) => second.data.pubDate.getTime() - first.data.pubDate.getTime());

const posts = variant === "agents" ? allPosts.filter(isAgentNote).slice(0, 6) : allPosts.filter((post) => !isAgentNote(post)).slice(0, 3);

const copy = variant === "agents"
  ? {
      id: "agent-notes",
      label: "AGENT_FIELD_NOTES.md",
      heading: "AI agents in production",
      sub: "Benchmarks, traces and harness design from building and securing AI agents.",
      cta: "/blog#ai-agents",
      gridClass: "md:grid-cols-3",
    }
  : {
      id: "writing",
      label: "RECENT_NOTES.md",
      heading: "Ideas worth sharing",
      sub: "Three recent notes on building and technology.",
      cta: "/blog",
      gridClass: "md:grid-cols-3",
    };
---

<section id={copy.id}>
  <div class="mb-8 animate-on-scroll">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="pixel-date mb-3">{copy.label}</p>
        <h2 class="text-3xl md:text-4xl mb-2">{copy.heading}</h2>
        <p class="text-base text-[var(--text-muted)]">{copy.sub}</p>
      </div>
      {copy.cta.startsWith("/") ? (
        <a href={copy.cta} class="pixel-button pixel-button-ghost text-sm">Read all →</a>
      ) : (
        <a href={copy.cta} target="_blank" rel="noopener noreferrer" class="pixel-button pixel-button-ghost text-sm">Read all ↗</a>
      )}
    </div>
  </div>

  <div class={`grid grid-cols-1 gap-4 ${copy.gridClass}`}>
    {posts.map((post, index) => (
      <a
        href={post.data.externalUrl || "https://nancy-chauhan.medium.com/"}
        target="_blank"
        rel="noopener noreferrer"
        class={`note-card animate-on-scroll stagger-${(index % 3) + 1}`}
      >
        {post.data.image && (
          <div class="note-image">
            <img src={post.data.image} alt="" loading="lazy" />
          </div>
        )}
        <div class="note-content">
          <span class="note-number">0{index + 1}</span>
          <h3>{post.data.title}</h3>
          <div class="mt-auto flex flex-wrap gap-1.5 pt-5">
            {post.data.tags.slice(0, 2).map((tag) => <span class="tag-brutal">{tag}</span>)}
          </div>
        </div>
        <span class="note-arrow">↗</span>
      </a>
    ))}
  </div>
</section>

<style>
  .note-card {
    position: relative;
    display: flex;
    min-height: 290px;
    flex-direction: column;
    border: 2px solid var(--pixel-ink);
    background: var(--pixel-card);
    box-shadow: 4px 4px 0 var(--pixel-shadow);
    color: var(--pixel-ink);
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .note-image {
    height: 8.5rem;
    overflow: hidden;
    border-bottom: 2px solid var(--pixel-ink);
    background: var(--pixel-lilac);
  }

  .note-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .note-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1rem;
  }

  .note-card:hover {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 var(--pixel-shadow);
  }

  .note-number {
    color: var(--pixel-purple);
    font-family: var(--pixel-font);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .note-card h3 {
    max-width: 90%;
    margin-top: 0.8rem;
    color: var(--pixel-ink);
    font-family: var(--pixel-font);
    font-size: clamp(1.05rem, 1.35vw, 1.15rem);
    font-weight: 700;
    line-height: 1.35;
  }

  .note-arrow {
    position: absolute;
    right: 0.7rem;
    top: 0.7rem;
    display: grid;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border: 2px solid var(--pixel-ink);
    background: var(--pixel-yellow);
    color: var(--pixel-ink);
    font-family: var(--pixel-font);
  }

  @media (max-width: 767px) {
    .note-card { min-height: 0; }
    .note-image { height: auto; aspect-ratio: 16 / 9; }
  }

  /* Phones: compact row — small thumbnail left, title right. */
  @media (max-width: 639px) {
    .note-card {
      flex-direction: row;
      align-items: stretch;
      box-shadow: 3px 3px 0 var(--pixel-shadow);
    }
    .note-image {
      width: 6.5rem;
      flex-shrink: 0;
      aspect-ratio: auto;
      border-right: 2px solid var(--pixel-ink);
      border-bottom: 0;
    }
    .note-content { padding: 0.7rem 2.2rem 0.7rem 0.8rem; }
    .note-number { font-size: 0.62rem; }
    .note-card h3 {
      max-width: none;
      margin-top: 0.25rem;
      font-size: 0.86rem;
      line-height: 1.3;
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }
    .note-content > div:last-child { padding-top: 0.5rem; }
    .note-content .tag-brutal:nth-child(n + 2) { display: none; }
    .note-arrow { right: 0.45rem; top: 0.45rem; width: 1.35rem; height: 1.35rem; font-size: 0.75rem; }
  }
</style>
