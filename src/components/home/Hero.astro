---
---

<section class="pixel-hero">
  <div class="pixel-sky" aria-hidden="true">
    <span class="pixel-cloud cloud-one"></span>
    <span class="pixel-cloud cloud-two"></span>
    <span class="pixel-star star-one">✦</span>
    <span class="pixel-star star-two">+</span>
    <span class="pixel-star star-three">✦</span>
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-6 pb-12 pt-14 md:px-24 md:pb-16 md:pt-20">
    <div class="grid items-center gap-10 md:grid-cols-[1.15fr_0.85fr] md:gap-14">
      <div class="order-2 md:order-1">
        <p class="pixel-overline"><span></span> ENGINEER · PRODUCT BUILDER</p>
        <h1 class="pixel-title">
          Hi, I’m <span>Nancy</span>.<br />
          I love to build<br />
          and <mark>ship.</mark>
        </h1>
        <p class="pixel-lede">
          I turn user problems into products across AI, security, and open source. Then I share what I learn along the way.
        </p>

        <div class="flex flex-wrap gap-3 mt-8">
          <a href="/projects" class="pixel-button pixel-button-primary">
            <span aria-hidden="true">▶</span> Start exploring
          </a>
          <a href="/about" class="pixel-button pixel-button-ghost">About player</a>
        </div>

      </div>

      <div class="order-1 md:order-2">
        <a href="/about" class="pixel-profile-shell" aria-label="Learn more about Nancy Chauhan">
          <div class="pixel-window-bar">
            <span>PLAYER_PROFILE.exe</span>
            <div><i></i><i></i><i></i></div>
          </div>
          <div class="pixel-profile-image">
            <img src="/nancy-speaking.jpeg" alt="Nancy Chauhan speaking at a conference" />
            <span class="pixel-photo-label">NANCY // LVL. 10</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>
