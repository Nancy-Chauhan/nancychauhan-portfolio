---
// Each logo gets a tailored width to ensure equal visual weight
// Square icons get narrow widths, horizontal wordmarks get wider
const logos = [
  { name: "Arize AI", href: "https://arize.com/", src: "/logos/arize.svg", style: "height:24px;width:auto;" },
  { name: "ONA", href: "https://ona.com/", src: "/logos/ona.svg", style: "height:24px;width:auto;" },
  { name: "LocalStack", href: "https://www.localstack.cloud/", src: "/logos/localstack.svg", style: "height:26px;width:auto;" },
  { name: "Blinkit", href: "https://blinkit.com/", src: "/logos/blinkit.svg", style: "height:24px;width:auto;" },
  { name: "Rootly", href: "https://rootly.com/", src: "/logos/rootly.png", style: "height:22px;width:auto;" },
  { name: "Exostellar", href: "https://www.qualcomm.com/data-center", src: "/logos/exostellar.svg", style: "height:20px;width:auto;" },
  { name: "Processing Foundation", href: "https://processingfoundation.org/", src: "/logos/processing-foundation.png", style: "height:36px;width:36px;" },
  { name: "FOSSi Foundation", href: "https://fossi-foundation.org/", src: "/logos/fossi.svg", style: "height:26px;width:auto;" },
  { name: "Zeotap", href: "https://zeotap.com/", src: "/logos/zeotap.svg", style: "height:22px;width:auto;" },
];
---

<section class="py-12 mx-auto max-w-6xl px-6 md:px-24">
  <div class="logo-heading mb-8">
    <p class="text-center text-sm text-[var(--text-secondary)] font-sans">
      Organisations I've worked and collaborated with
    </p>
    <button type="button" class="marquee-toggle" data-marquee-toggle aria-pressed="false">
      <span data-marquee-label>PAUSE</span> <span aria-hidden="true">Ⅱ</span>
    </button>
  </div>
  <div class="relative overflow-hidden">
    <div class="marquee-track flex items-center gap-14 w-max" data-marquee-track>
      {[...logos, ...logos].map((logo, index) => (
        <a
          href={logo.href}
          target="_blank"
          rel="noopener noreferrer"
          class="logo-item shrink-0 flex items-center justify-center"
          aria-label={index < logos.length ? `Visit ${logo.name}` : undefined}
          aria-hidden={index >= logos.length ? "true" : undefined}
          tabindex={index >= logos.length ? -1 : undefined}
        >
          <img src={logo.src} alt={index < logos.length ? logo.name : ""} aria-hidden={index >= logos.length ? "true" : undefined} style={logo.style} class="logo-light object-contain" />
          <img src={logo.src} alt="" aria-hidden="true" style={logo.style} class="logo-dark object-contain" />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .logo-heading { position: relative; display: flex; align-items: center; justify-content: center; min-height: 2.5rem; }
  .marquee-track { animation: marquee var(--marquee-duration, 22s) linear infinite; }
  .marquee-track.is-paused { animation-play-state: paused; }
  .marquee-track:hover,
  .marquee-track:focus-within { animation-play-state: paused; }
  .logo-item {
    min-width: 4rem;
    min-height: 3rem;
    padding: 0.45rem 0.65rem;
    border: 2px solid transparent;
    transition: background 0.12s ease, border-color 0.12s ease;
  }
  .logo-item:hover,
  .logo-item:focus-visible {
    border-color: var(--pixel-ink);
    background: var(--pixel-card);
  }
  .marquee-toggle {
    position: absolute;
    right: 0;
    padding: 0.35rem 0.5rem;
    border: 2px solid var(--pixel-ink);
    background: var(--pixel-card);
    box-shadow: 2px 2px 0 var(--pixel-shadow);
    color: var(--pixel-ink);
    font-family: var(--pixel-font);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .logo-dark { display: none; }

  :global(html[data-theme="dark"]) .logo-light { display: none; }
  :global(html[data-theme="dark"]) .logo-dark {
    display: block;
    filter: grayscale(1) brightness(0) invert(1);
    opacity: 1;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - 1.75rem)); }
  }

  @media (max-width: 640px) {
    .logo-heading { justify-content: flex-start; padding-right: 4.5rem; }
    .logo-heading p { text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track { width: 100%; flex-wrap: wrap; justify-content: center; transform: none; animation: none; }
    .logo-item:nth-child(n + 10) { display: none; }
    .marquee-toggle { display: none; }
  }
</style>

<script>
  function initLogoMarquee() {
    document.querySelectorAll<HTMLElement>("[data-marquee-track]").forEach((track) => {
      const container = track.closest("section");
      const toggle = container?.querySelector<HTMLButtonElement>("[data-marquee-toggle]");
      const label = toggle?.querySelector<HTMLElement>("[data-marquee-label]");
      if (!toggle || !label) return;

      const halfWidth = track.scrollWidth / 2;
      track.style.setProperty("--marquee-duration", `${Math.max(18, halfWidth / 45)}s`);
      if (toggle.dataset.marqueeBound) return;
      toggle.dataset.marqueeBound = "true";
      toggle.addEventListener("click", () => {
        const paused = track.classList.toggle("is-paused");
        toggle.setAttribute("aria-pressed", String(paused));
        label.textContent = paused ? "PLAY" : "PAUSE";
      });
    });
  }

  initLogoMarquee();
  document.addEventListener("astro:page-load", initLogoMarquee);
</script>
