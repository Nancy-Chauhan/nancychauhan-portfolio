---
const navLinks = [
  { href: "/projects", label: "PROJECTS", icon: "◆" },
  { href: "https://nancy-chauhan.medium.com/", label: "BLOG", icon: "▤", external: true },
  { href: "/speaking", label: "SPEAKING", icon: "))" },
  { href: "/about", label: "ABOUT", icon: "☺" },
];

const currentPath = Astro.url.pathname;
---

<header class="pixel-header sticky top-0 z-30">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 md:px-24">
    <a href="/#top" class="pixel-brand" aria-label="Nancy Chauhan, back to homepage">
      <span class="pixel-brand-icon">NC</span>
      <span>NANCY.CHAUHAN</span>
    </a>

    <div class="hidden items-center gap-2 xl:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          {...link.external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
          class:list={[
            "pixel-nav-link",
            currentPath === link.href || (!link.external && currentPath.startsWith(link.href)) ? "is-active" : "",
          ]}
        >
          <span aria-hidden="true">{link.icon}</span>{link.label}
        </a>
      ))}
      <div class="theme-picker" role="group" aria-label="Color theme">
        <button type="button" data-theme-choice="light" aria-pressed="true"><span aria-hidden="true">☀</span> LIGHT</button>
        <button type="button" data-theme-choice="dark" aria-pressed="false"><span aria-hidden="true">☾</span> DARK</button>
      </div>
      <a href="https://cal.com/nancychauhan" target="_blank" rel="noopener noreferrer" class="pixel-chat-link">LET’S CHAT ↗</a>
    </div>

    <div class="flex items-center gap-3 xl:hidden">
      <div class="theme-picker theme-picker-mobile" role="group" aria-label="Color theme">
        <button type="button" data-theme-choice="light" aria-label="Use light theme" aria-pressed="true">☀</button>
        <button type="button" data-theme-choice="dark" aria-label="Use dark theme" aria-pressed="false">☾</button>
      </div>
      <div class="mobile-navigation">
        <button class="pixel-menu-button" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
          <span></span><span></span><span></span>
        </button>
        <div id="mobile-menu" class="pixel-mobile-menu-panel border-t-2 border-[var(--pixel-ink)] bg-[var(--pixel-paper)] px-6 pb-5 pt-3" hidden>
          <div class="flex flex-col gap-1">
            {navLinks.map((link) => (
              <a
                href={link.href}
                {...link.external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
                class:list={[
                  "pixel-mobile-link",
                  currentPath === link.href || (!link.external && currentPath.startsWith(link.href)) ? "is-active" : "",
                ]}
              ><span aria-hidden="true">{link.icon}</span> <span>{link.label}</span><span class="mobile-link-arrow" aria-hidden="true">→</span></a>
            ))}
            <a href="https://cal.com/nancychauhan" target="_blank" rel="noopener noreferrer" class="pixel-mobile-link"><span aria-hidden="true">✦</span><span>LET’S CHAT</span><span class="mobile-link-arrow" aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  .mobile-navigation { position: relative; }

  .pixel-mobile-menu-panel {
    position: fixed;
    top: 4.75rem;
    right: 0;
    left: 0;
    width: 100%;
    max-height: calc(100dvh - 4.75rem);
    overflow-y: auto;
    box-shadow: 0 4px 0 var(--pixel-shadow);
  }

  .mobile-navigation.is-open .pixel-menu-button span:first-child { transform: translateY(6px) rotate(45deg); }
  .mobile-navigation.is-open .pixel-menu-button span:nth-child(2) { opacity: 0; }
  .mobile-navigation.is-open .pixel-menu-button span:last-child { transform: translateY(-6px) rotate(-45deg); }

  .pixel-mobile-link {
    display: grid;
    min-height: 3.25rem;
    grid-template-columns: 1.35rem 1fr auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.8rem 0.4rem;
  }

  .pixel-mobile-link:hover,
  .pixel-mobile-link:active,
  .pixel-mobile-link.is-active { background: var(--pixel-lilac); }
  .pixel-mobile-link > span:first-child { color: var(--pixel-purple-dark); }
  .mobile-link-arrow { font-size: 1.1rem; }

  .theme-picker {
    display: inline-flex;
    border: 2px solid var(--pixel-ink);
    background: var(--pixel-card);
    box-shadow: 3px 3px 0 var(--pixel-shadow);
  }

  .theme-picker button {
    min-height: 2.5rem;
    padding: 0.45rem 0.6rem;
    color: var(--text-muted);
    font-family: var(--pixel-font);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .theme-picker button + button { border-left: 2px solid var(--pixel-ink); }
  .theme-picker button[aria-pressed="true"] { background: var(--pixel-purple); color: white; }
  :global(html[data-theme="dark"]) .theme-picker button[aria-pressed="true"] { color: #151126; }
  .theme-picker-mobile button { width: 2.75rem; height: 2.75rem; padding: 0; font-size: 1rem; }

  @media (max-width: 480px) {
    :global(.pixel-brand > span:last-child) { display: none; }
    .pixel-mobile-menu-panel { padding-inline: 1rem; }
  }
</style>

<script>
  function syncThemeControls() {
    const theme = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    document.querySelectorAll<HTMLButtonElement>("[data-theme-choice]").forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.themeChoice === theme));
    });
  }

  function bindThemeControls() {
    syncThemeControls();
    document.querySelectorAll<HTMLButtonElement>("[data-theme-choice]").forEach((button) => {
      if (button.dataset.themeBound) return;
      button.dataset.themeBound = "true";
      button.addEventListener("click", () => {
        const theme = button.dataset.themeChoice === "dark" ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme === "dark" ? "dark" : "only light";
        localStorage.setItem("nancy-theme", theme);
        syncThemeControls();
      });
    });
  }

  function bindMobileNavigation() {
    const navigation = document.querySelector<HTMLElement>(".mobile-navigation");
    const button = navigation?.querySelector<HTMLButtonElement>(".pixel-menu-button");
    const menu = navigation?.querySelector<HTMLElement>(".pixel-mobile-menu-panel");
    if (!navigation || !button || !menu || button.dataset.menuBound) return;

    button.dataset.menuBound = "true";

    const setMenuOpen = (open: boolean) => {
      navigation.classList.toggle("is-open", open);
      menu.hidden = !open;
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
    };

    button.addEventListener("click", () => {
      setMenuOpen(button.getAttribute("aria-expanded") !== "true");
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && button.getAttribute("aria-expanded") === "true") {
        setMenuOpen(false);
        button.focus();
      }
    });

    document.addEventListener("click", (event) => {
      if (button.getAttribute("aria-expanded") === "true" && !navigation.contains(event.target as Node)) {
        setMenuOpen(false);
      }
    });
  }

  bindThemeControls();
  bindMobileNavigation();
  document.addEventListener("astro:page-load", () => {
    bindThemeControls();
    bindMobileNavigation();
  });
</script>
