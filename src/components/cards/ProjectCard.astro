---
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  title: string;
  tagline: string;
  techStack: string[];
  slug: string;
}

const { title, tagline, techStack, slug } = Astro.props;

const projectVisuals: Record<string, { label: string; background: string; accent: string }> = {
  skillfeed: { label: "CURATE", background: "#d9ceff", accent: "#7557d9" },
  "llm-powered-threat-modelling": { label: "MODEL", background: "#ffd2e7", accent: "#e94b91" },
  preflight: { label: "CHECK", background: "#c9dfff", accent: "#438bd1" },
  secloop: { label: "SCAN", background: "#c5f2db", accent: "#2ea36e" },
  "attacktree-app": { label: "MAP", background: "#ffd2bd", accent: "#e87955" },
  "mcp-agent-os": { label: "AGENT", background: "#d9ceff", accent: "#7557d9" },
  "info-disclosure-scanner": { label: "FIND", background: "#fff0b8", accent: "#d39a17" },
  hearth: { label: "DECIDE", background: "#ffdcc2", accent: "#de6b35" },
  agentjail: { label: "GUARD", background: "#ffd5df", accent: "#d13d63" },
};

const visual = projectVisuals[slug] ?? { label: "BUILD", background: "#d9ceff", accent: "#7557d9" };

const techLogos: Record<string, string> = {
  "Next.js 16": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nextjs/nextjs-original.svg",
  "TypeScript": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg",
  "Supabase": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/supabase/supabase-original.svg",
  "React 18": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg",
  "Python": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg",
  "FastAPI": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/fastapi/fastapi-original.svg",
  "PostgreSQL": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg",
  "SQLite": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/sqlite/sqlite-original.svg",
  "Bun": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/bun/bun-original.svg",
  "Claude API": "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/anthropic.svg",
  "Anthropic API": "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/anthropic.svg",
  "Claude Code Plugin": "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/anthropic.svg",
  "OpenAI / Claude API": "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/openai.svg",
  "Hono": "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/hono.svg",
  "Groq API": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/groq/groq-original.svg",
  "Resend": "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/resend.svg",
  "Llama 3.1 70B": "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/meta.svg",
  "HTML Reports": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/html5/html5-original.svg",
  "40+ Service Integrations": "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/zapier.svg",
  "Agno Framework": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg",
  "Tailwind CSS v4": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tailwindcss/tailwindcss-original.svg",
  "Tailwind CSS": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tailwindcss/tailwindcss-original.svg",
  "Drizzle ORM": "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/drizzle.svg",
  "Arize OpenTelemetry": "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/opentelemetry.svg",
};
---

<a href={`/projects/${slug}`} class="group block card-brutal overflow-hidden h-full flex flex-col" transition:name={`project-${slug}`}>
  <div class="window-chrome">
    <div class="window-dot" style="background:#ff5f57;"></div>
    <div class="window-dot" style="background:#febc2e;"></div>
    <div class="window-dot" style="background:#28c840;"></div>
    <span class="window-chrome-title">~/projects/{slug}</span>
  </div>

  <div class="project-preview" style={`--preview-bg:${visual.background};--preview-accent:${visual.accent};`}>
    <ProjectVisual slug={slug} />
    <span class="preview-label">{visual.label}.px</span>
  </div>

  <div class="px-4 pt-3 pb-3 flex flex-col flex-1">
    <h3 class="text-lg font-bold font-sans text-[var(--color-stone-900)] mb-1 group-hover:text-[var(--color-purple)] transition-colors">{title}</h3>
    <p class="project-tagline text-sm text-[var(--color-stone-600)] font-sans leading-relaxed mb-2 flex-1">{tagline}</p>
    <span class="project-cta">Check it out <b aria-hidden="true">→</b></span>
  </div>
</a>

<style>
  .project-preview {
    position: relative;
    display: grid;
    height: 104px;
    place-items: center;
    overflow: hidden;
    border-bottom: 2px solid var(--pixel-ink);
    background: var(--preview-bg);
  }

  .window-chrome-title { font-size: 0.76rem; }

  .project-preview::after {
    content: "";
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 7px rgba(255, 250, 240, 0.28);
    pointer-events: none;
  }

  .preview-label {
    position: absolute;
    z-index: 1;
    right: 0.65rem;
    bottom: 0.55rem;
    padding: 0.2rem 0.32rem;
    border: 1px solid var(--pixel-ink);
    background: var(--pixel-card);
    color: var(--pixel-ink);
    font-family: var(--pixel-font);
    font-size: 0.54rem;
    font-weight: 700;
  }

  .project-tagline {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .project-cta {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.7rem;
    border: 2px solid var(--pixel-ink);
    background: var(--pixel-card);
    box-shadow: 2px 2px 0 var(--pixel-shadow);
    color: var(--pixel-ink);
    font-family: var(--pixel-font);
    font-size: 0.84rem;
    font-weight: 700;
  }

  .group:hover .project-cta {
    background: var(--preview-bg);
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 var(--pixel-shadow);
  }

  @media (max-width: 520px) {
    .project-preview { height: 92px; }
  }

</style>
