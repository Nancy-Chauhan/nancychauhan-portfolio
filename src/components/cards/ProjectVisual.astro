<style>
  .project-visual {
    position: relative;
    z-index: 1;
    display: grid;
    width: 250px;
    height: 94px;
    place-items: center;
    transition: transform 0.2s ease;
  }

  .product-shot {
    width: 228px;
    height: 82px;
    overflow: hidden;
    border: 2px solid var(--pixel-ink);
    border-radius: 2px;
    background: #fff;
    box-shadow: 5px 5px 0 color-mix(in srgb, var(--preview-accent) 68%, var(--pixel-ink));
  }

  .product-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.04);
  }

  .visual-skillfeed .product-shot,
  .visual-mcp-agent-os .product-shot { transform: rotate(-1deg); }
  .visual-secloop .product-shot,
  .visual-info-disclosure-scanner .product-shot { transform: rotate(1deg); }
  .visual-llm-powered-threat-modelling .product-shot { transform: rotate(-1deg); }
  .visual-skillfeed .product-shot img,
  .visual-mcp-agent-os .product-shot img,
  .visual-secloop .product-shot img { object-fit: cover; }

  .custom-art {
    display: block;
    width: 220px;
    height: 91px;
    overflow: visible;
    filter: drop-shadow(5px 5px 0 color-mix(in srgb, var(--preview-accent) 65%, var(--pixel-ink)));
  }

  .panel { fill: var(--pixel-card); stroke: var(--pixel-ink); stroke-width: 3; }
  .panel-bar { fill: var(--preview-accent); stroke: var(--pixel-ink); stroke-width: 3; }
  .dot-red { fill: #ff5f57; }
  .dot-yellow { fill: #febc2e; }
  .dot-green { fill: #28c840; }
  .connector,
  .check,
  .agent-mouth,
  .antenna,
  .lock-loop {
    fill: none;
    stroke: var(--pixel-ink);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .node { fill: var(--preview-bg); stroke: var(--preview-accent); stroke-width: 3; }
  .shield { fill: var(--preview-accent); stroke: var(--pixel-ink); stroke-width: 3; stroke-linejoin: round; }
  .check { stroke: #fff; stroke-width: 4; }
  .jail-panel { fill: color-mix(in srgb, var(--preview-bg) 42%, var(--pixel-card)); }
  .agent-head { fill: var(--pixel-ink); }
  .agent-eye { fill: var(--pixel-mint); }
  .agent-mouth { stroke: var(--pixel-card); }
  .bar { fill: var(--preview-accent); stroke: var(--pixel-ink); stroke-width: 2; }
  .lock { fill: var(--pixel-yellow); stroke: var(--pixel-ink); stroke-width: 3; }

  .query-line, .fan { fill: none; stroke: var(--pixel-ink); stroke-width: 2.5; stroke-linecap: round; }
  .fan { stroke: var(--preview-accent); stroke-width: 2; }
  .decision { fill: var(--preview-accent); stroke: var(--pixel-ink); stroke-width: 3; }
  .decision-text { fill: #fff; font: 700 12px var(--pixel-font, monospace); text-anchor: middle; }
  .pick-bar { fill: var(--pixel-yellow); stroke: var(--pixel-ink); stroke-width: 2.5; }
  .option-bar { fill: color-mix(in srgb, var(--preview-bg) 60%, var(--pixel-card)); stroke: var(--preview-accent); stroke-width: 2; }
  .score { fill: var(--pixel-ink); font: 700 8px var(--pixel-font, monospace); }
  .score.muted { fill: var(--preview-accent); }

  .thin { fill: none; stroke: var(--pixel-ink); stroke-width: 2; stroke-linecap: round; }
  .head { fill: none; stroke: var(--pixel-ink); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .accent-stroke { stroke: var(--preview-accent); }
  .loop { fill: none; stroke: var(--preview-accent); stroke-width: 2.5; stroke-dasharray: 5 4; stroke-linecap: round; }
  .limit { fill: none; stroke: #e5484d; stroke-width: 2; stroke-dasharray: 5 4; }
  .burst { fill: none; stroke: #e5484d; stroke-width: 3; stroke-linecap: round; }
  .attack { fill: none; stroke: #e5484d; stroke-width: 3; stroke-linecap: round; }
  .danger-bar { fill: #e5484d; stroke: var(--pixel-ink); stroke-width: 2.5; }
  .node-hot { fill: var(--preview-accent); stroke: var(--pixel-ink); }
  .tile { fill: color-mix(in srgb, var(--preview-bg) 55%, var(--pixel-card)); stroke: var(--preview-accent); stroke-width: 2; }
  .tile-hot { fill: var(--preview-accent); stroke: var(--pixel-ink); stroke-width: 2.5; }
  .label { fill: var(--pixel-ink); font: 700 7px var(--pixel-font, monospace); text-anchor: middle; }
  .label.start { text-anchor: start; }
  .label-light, .letter-light { fill: #fff; }
  .accent-text { fill: var(--preview-accent); }
  .danger-text { fill: #e5484d; }
  .letter { fill: var(--pixel-ink); font: 700 12px var(--pixel-font, monospace); text-anchor: middle; }
  .ok { fill: var(--pixel-mint, #7ee0b1); stroke: var(--pixel-ink); stroke-width: 2; }
  .ok + .check { stroke: var(--pixel-ink); stroke-width: 2.5; fill: none; }
  .doc { fill: var(--pixel-card); stroke: var(--pixel-ink); stroke-width: 2.5; }
  .doc-bar { fill: var(--preview-accent); stroke: var(--pixel-ink); stroke-width: 2.5; }
  .star { fill: var(--pixel-yellow); stroke: var(--pixel-ink); stroke-width: 1.5; stroke-linejoin: round; }
  .code { fill: color-mix(in srgb, var(--preview-accent) 30%, var(--pixel-card)); }
  .leak-box { fill: #ffe3e3; stroke: #e5484d; stroke-width: 2; }
  .lens { fill: color-mix(in srgb, var(--preview-bg) 45%, transparent); stroke: var(--pixel-ink); stroke-width: 3.5; }
  .handle { fill: none; stroke: var(--pixel-ink); stroke-width: 6; stroke-linecap: round; }

  :global(.group:hover) .project-visual { transform: translateY(-3px) scale(1.015); }

  @media (prefers-reduced-motion: reduce) {
    .project-visual { transition: none; }
  }
</style>
