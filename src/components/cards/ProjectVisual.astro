---
interface Props {
  slug: string;
}

const { slug } = Astro.props;

const projectShots: Record<string, { src: string; position: string }> = {
  skillfeed: { src: "/projects/skillfeed-architecture.svg", position: "center 18%" },
  preflight: { src: "/projects/preflight-overview.png", position: "center 19%" },
  secloop: { src: "/projects/secloop-architecture.svg", position: "center 27%" },
  "attacktree-app": { src: "/projects/attacktree-demo.png", position: "center 18%" },
  "mcp-agent-os": { src: "/projects/mcp-agent-os-architecture.png", position: "center" },
  "info-disclosure-scanner": { src: "/projects/info-scanner-screenshot.png", position: "center 12%" },
};

const shot = projectShots[slug];
---

<div class:list={["project-visual", `visual-${slug}`]} aria-hidden="true">
  {shot ? (
    <div class="product-shot">
      <img src={shot.src} alt="" loading="lazy" decoding="async" style={`object-position:${shot.position};`} />
    </div>
  ) : slug === "llm-powered-threat-modelling" ? (
    <svg class="custom-art" viewBox="0 0 190 96" role="presentation">
      <rect class="panel" x="13" y="9" width="164" height="78" rx="4" />
      <rect class="panel-bar" x="13" y="9" width="164" height="14" rx="4" />
      <circle class="dot-red" cx="23" cy="16" r="3" />
      <circle class="dot-yellow" cx="33" cy="16" r="3" />
      <circle class="dot-green" cx="43" cy="16" r="3" />
      <path class="connector" d="M47 48h22M121 48h22M95 35V26M95 70V61" />
      <rect class="node" x="26" y="38" width="25" height="20" rx="3" />
      <rect class="node" x="139" y="38" width="25" height="20" rx="3" />
      <rect class="node" x="83" y="24" width="24" height="18" rx="3" />
      <rect class="node" x="83" y="60" width="24" height="18" rx="3" />
      <path class="shield" d="m95 35 21 8v12c0 13-9 21-21 27-12-6-21-14-21-27V43z" />
      <path class="check" d="m86 55 7 7 13-15" />
    </svg>
  ) : (
    <svg class="custom-art" viewBox="0 0 190 96" role="presentation">
      <rect class="panel jail-panel" x="18" y="8" width="154" height="80" rx="4" />
      <rect class="panel-bar" x="18" y="8" width="154" height="15" rx="4" />
      <circle class="dot-red" cx="29" cy="15.5" r="3" />
      <circle class="dot-yellow" cx="39" cy="15.5" r="3" />
      <circle class="dot-green" cx="49" cy="15.5" r="3" />
      <rect class="agent-head" x="71" y="31" width="48" height="41" rx="7" />
      <rect class="agent-eye" x="80" y="43" width="8" height="8" rx="2" />
      <rect class="agent-eye" x="102" y="43" width="8" height="8" rx="2" />
      <path class="agent-mouth" d="M83 61h24" />
      <path class="antenna" d="M95 31v-8M88 23h14" />
      <rect class="bar" x="48" y="26" width="7" height="54" rx="2" />
      <rect class="bar" x="66" y="26" width="7" height="54" rx="2" />
      <rect class="bar" x="117" y="26" width="7" height="54" rx="2" />
      <rect class="bar" x="135" y="26" width="7" height="54" rx="2" />
      <rect class="lock" x="84" y="67" width="22" height="17" rx="3" />
      <path class="lock-loop" d="M89 68v-5a6 6 0 0 1 12 0v5" />
    </svg>
  )}
</div>

<style>
  .project-visual {
    position: relative;
    z-index: 1;
    display: grid;
    width: 250px;
    height: 94px;
    place-items: center;
    transition: transform 0.2s ease;
  }

  .product-shot {
    width: 228px;
    height: 82px;
    overflow: hidden;
    border: 2px solid var(--pixel-ink);
    border-radius: 2px;
    background: #fff;
    box-shadow: 5px 5px 0 color-mix(in srgb, var(--preview-accent) 68%, var(--pixel-ink));
  }

  .product-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.04);
  }

  .visual-skillfeed .product-shot,
  .visual-mcp-agent-os .product-shot { transform: rotate(-1deg); }
  .visual-secloop .product-shot,
  .visual-info-disclosure-scanner .product-shot { transform: rotate(1deg); }
  .visual-skillfeed .product-shot img,
  .visual-mcp-agent-os .product-shot img,
  .visual-secloop .product-shot img { object-fit: cover; }

  .custom-art {
    display: block;
    width: 220px;
    height: 91px;
    overflow: visible;
    filter: drop-shadow(5px 5px 0 color-mix(in srgb, var(--preview-accent) 65%, var(--pixel-ink)));
  }

  .panel { fill: var(--pixel-card); stroke: var(--pixel-ink); stroke-width: 3; }
  .panel-bar { fill: var(--preview-accent); stroke: var(--pixel-ink); stroke-width: 3; }
  .dot-red { fill: #ff5f57; }
  .dot-yellow { fill: #febc2e; }
  .dot-green { fill: #28c840; }
  .connector,
  .check,
  .agent-mouth,
  .antenna,
  .lock-loop {
    fill: none;
    stroke: var(--pixel-ink);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .node { fill: var(--preview-bg); stroke: var(--preview-accent); stroke-width: 3; }
  .shield { fill: var(--preview-accent); stroke: var(--pixel-ink); stroke-width: 3; stroke-linejoin: round; }
  .check { stroke: #fff; stroke-width: 4; }
  .jail-panel { fill: color-mix(in srgb, var(--preview-bg) 42%, var(--pixel-card)); }
  .agent-head { fill: var(--pixel-ink); }
  .agent-eye { fill: var(--pixel-mint); }
  .agent-mouth { stroke: var(--pixel-card); }
  .bar { fill: var(--preview-accent); stroke: var(--pixel-ink); stroke-width: 2; }
  .lock { fill: var(--pixel-yellow); stroke: var(--pixel-ink); stroke-width: 3; }

  :global(.group:hover) .project-visual { transform: translateY(-3px) scale(1.015); }

  @media (prefers-reduced-motion: reduce) {
    .project-visual { transition: none; }
  }
</style>
