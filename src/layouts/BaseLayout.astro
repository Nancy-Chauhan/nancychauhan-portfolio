---
import community from "../data/community.json";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../data/profile";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  socialImage?: string;
  socialImageAlt?: string;
  preloadImage?: string;
  pageType?: "website" | "article";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "Nancy Chauhan - Engineer & Developer Advocate",
  canonical,
  socialImage = "/og-image.png",
  socialImageAlt = "Nancy Chauhan, engineer and product builder",
  preloadImage,
  pageType = "website",
  structuredData = [],
} = Astro.props;
const siteUrl = Astro.site ?? "https://nancychauhan.com";
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, siteUrl);
const socialImageUrl = new URL(socialImage, siteUrl);
const personSchema = {
  "@type": "Person",
  "@id": `${profile.url}/#person`,
  name: profile.name,
  url: profile.url,
  image: profile.image,
  jobTitle: profile.jobTitle,
  description: profile.description,
  knowsAbout: profile.expertise,
  award: ["CNCF TAGGIE Award", "Sessionize Top 3% most active speakers (2025)"],
  worksFor: { "@type": "Organization", name: profile.currentRole.company, url: profile.currentRole.companyUrl },
  alumniOf: profile.education.map((item) => ({ "@type": "CollegeOrUniversity", name: item.school })),
  hasCredential: [
    {
      "@type": "EducationalOccupationalCredential",
      name: profile.education[0].degree,
      credentialCategory: "degree",
      dateCreated: "2025-05",
      recognizedBy: { "@type": "CollegeOrUniversity", name: profile.education[0].school },
    },
    {
      "@type": "EducationalOccupationalCredential",
      name: "AWS Community Builder, Security & Identity",
      credentialCategory: "community program",
      dateCreated: "2024",
      expires: "2025",
      recognizedBy: { "@type": "Organization", name: "Amazon Web Services" },
    },
  ],
  memberOf: profile.affiliations
    .filter((item) => item.status === "current")
    .map((item) => ({ "@type": "Organization", name: item.organization, url: item.url })),
  sameAs: profile.sameAs,
  // Community roles shown on /community, so agents can answer "what communities does she lead?"
  founder: { "@type": "Organization", name: community.founded.name, foundingDate: "2022-12" },
  hasOccupation: community.events
    .filter((event) => ["Co-Chair", "Lead organiser", "Organiser"].includes(event.role))
    .map((event) => ({ "@type": "Role", roleName: event.role, description: `${event.title} (${event.year})` })),
};
const websiteSchema = {
  "@type": "WebSite",
  "@id": `${profile.url}/#website`,
  url: profile.url,
  name: `${profile.name} — Portfolio`,
  description: profile.description,
  inLanguage: "en",
  author: { "@id": `${profile.url}/#person` },
};
const webPageSchema = {
  "@type": "WebPage",
  "@id": `${canonicalUrl.href}#webpage`,
  url: canonicalUrl.href,
  name: title,
  description,
  inLanguage: "en",
  isPartOf: { "@id": `${profile.url}/#website` },
  about: { "@id": `${profile.url}/#person` },
};
const extraSchemas = Array.isArray(structuredData) ? structuredData : [structuredData];
const schemaGraph = { "@context": "https://schema.org", "@graph": [personSchema, websiteSchema, webPageSchema, ...extraSchemas] };
const serializedSchema = JSON.stringify(schemaGraph).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en" data-theme="light" style="color-scheme: only light;">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        let theme = "light";
        try {
          theme = localStorage.getItem("nancy-theme") === "dark" ? "dark" : "light";
        } catch {}
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme === "dark" ? "dark" : "only light";
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#f4efe5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content="Nancy Chauhan" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" type="image/gif" href="/favicon.gif" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Pixelify+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="AI-readable site overview" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Complete AI-readable portfolio" />
    <link rel="alternate" type="application/json" href="/api/site.json" title="Machine-readable portfolio index" />
    <link rel="alternate" type="application/rss+xml" href="/feed.xml" title="Nancy Chauhan writing feed" />
    <script type="application/ld+json" set:html={serializedSchema}></script>
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      function initAnimations() {
        const elements = document.querySelectorAll(".animate-on-scroll");
        if (!("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          elements.forEach((element) => element.classList.add("visible"));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
        );
        elements.forEach((el) => {
          observer.observe(el);
        });
      }
      initAnimations();
      document.addEventListener("astro:page-load", initAnimations);
    </script>
  </body>
</html>
