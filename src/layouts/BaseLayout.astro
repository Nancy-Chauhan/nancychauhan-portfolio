---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../data/profile";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  socialImage?: string;
  pageType?: "website" | "article";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "Nancy Chauhan - Engineer & Developer Advocate",
  canonical,
  socialImage = "/og-image.png",
  pageType = "website",
  structuredData = [],
} = Astro.props;
const siteUrl = Astro.site ?? "https://nancychauhan.com";
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, siteUrl);
const socialImageUrl = new URL(socialImage, siteUrl);
const personSchema = {
  "@type": "Person",
  "@id": `${profile.url}/#person`,
  name: profile.name,
  url: profile.url,
  image: profile.image,
  jobTitle: profile.jobTitle,
  description: profile.description,
  knowsAbout: profile.expertise,
  award: ["CNCF TAGGIE Award"],
  worksFor: { "@type": "Organization", name: profile.currentRole.company, url: profile.currentRole.companyUrl },
  alumniOf: profile.education.map((item) => ({ "@type": "CollegeOrUniversity", name: item.school })),
  hasCredential: [
    {
      "@type": "EducationalOccupationalCredential",
      name: profile.education[0].degree,
      credentialCategory: "degree",
      dateCreated: "2025-05",
      recognizedBy: { "@type": "CollegeOrUniversity", name: profile.education[0].school },
    },
    {
      "@type": "EducationalOccupationalCredential",
      name: "AWS Community Builder, Security & Identity",
      credentialCategory: "community program",
      dateCreated: "2024",
      expires: "2025",
      recognizedBy: { "@type": "Organization", name: "Amazon Web Services" },
    },
  ],
  memberOf: profile.affiliations
    .filter((item) => item.status === "current")
    .map((item) => ({ "@type": "Organization", name: item.organization, url: item.url })),
  sameAs: profile.sameAs,
};
const websiteSchema = {
  "@type": "WebSite",
  "@id": `${profile.url}/#website`,
  url: profile.url,
  name: `${profile.name} — Portfolio`,
  description: profile.description,
  inLanguage: "en",
  author: { "@id": `${profile.url}/#person` },
};
const extraSchemas = Array.isArray(structuredData) ? structuredData : [structuredData];
const schemaGraph = { "@context": "https://schema.org", "@graph": [personSchema, websiteSchema, ...extraSchemas] };
const serializedSchema = JSON.stringify(schemaGraph).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en" data-theme="light" style="color-scheme: only light;">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("nancy-theme");
        const theme = savedTheme === "dark" ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme === "dark" ? "dark" : "only light";
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="only light" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nancy Chauhan, engineer and product builder" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="icon" type="image/gif" href="/favicon.gif" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&family=Pixelify+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="AI-readable site overview" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Complete AI-readable portfolio" />
    <link rel="alternate" type="application/json" href="/api/site.json" title="Machine-readable portfolio index" />
    <link rel="alternate" type="application/rss+xml" href="/feed.xml" title="Nancy Chauhan writing feed" />
    <script type="application/ld+json" set:html={serializedSchema}></script>
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main id="top" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      function initAnimations() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
        );
        document.querySelectorAll(".animate-on-scroll").forEach((el) => {
          observer.observe(el);
        });
      }
      initAnimations();
      document.addEventListener("astro:page-load", initAnimations);
    </script>
  </body>
</html>
