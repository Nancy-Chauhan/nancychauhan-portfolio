---
import BaseLayout from "../layouts/BaseLayout.astro";
import Talks from "../components/home/Talks.astro";
import Courses from "../components/home/Courses.astro";
import talks from "../data/talks/talks.json";

const getYouTubeId = (url: string) => new URL(url).searchParams.get("v");
const talkListSchema = {
  "@type": "ItemList",
  "@id": "https://nancychauhan.com/speaking#talks",
  name: "Conference talks by Nancy Chauhan",
  itemListElement: talks.filter((talk) => talk.video).map((talk, index) => {
    const videoId = getYouTubeId(talk.video as string);
    return {
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "VideoObject",
        name: talk.title,
        description: `${talk.type} at ${talk.event} (${talk.year})`,
        contentUrl: talk.video,
        ...(videoId ? { thumbnailUrl: `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg` } : {}),
        creator: { "@id": "https://nancychauhan.com/#person" },
      },
    };
  }),
};
---

<BaseLayout
  title="Speaking: Talks, Webinars & Courses | Nancy Chauhan"
  description="Keynotes, conference talks, webinars and video courses by Nancy Chauhan on AI agents, cloud native, security and sustainability."
  structuredData={talkListSchema}
>
  <section class="pixel-page-hero py-16 md:py-20">
    <div class="relative z-10 mx-auto max-w-6xl px-6 md:px-24">
      <p class="pixel-date mb-4">SPEAKING_LOG.txt</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-5">Speaking</h1>
      <p class="max-w-2xl text-lg leading-relaxed">
        Keynotes, conference talks, webinars and courses: ideas I’ve shared on stage and on screen.
      </p>
    </div>
  </section>

  <div class="pixel-page homepage-pixel-zone mx-auto max-w-6xl px-6 py-16 md:px-24 md:py-20">
    <Talks />
    <hr class="section-divider my-16" />
    <Talks variant="webinars" />
    <hr class="section-divider my-16" />
    <Courses />
    <hr class="section-divider my-16" />
    <a href="/community" class="next-page card-brutal">
      <span class="pixel-date">NEXT_PAGE</span>
      <span class="next-page-title">Community →</span>
      <span class="next-page-sub">Women in Cloud Native, CNCF TAG leadership, events I organise and recognition.</span>
    </a>
  </div>
</BaseLayout>

<style>
  .next-page {
    display: grid;
    gap: 0.35rem;
    padding: 1.2rem 1.4rem;
    color: var(--text-primary);
    transition: transform 0.12s, box-shadow 0.12s;
  }
  .next-page:hover { transform: translate(3px, 3px); box-shadow: 1px 1px 0 var(--pixel-shadow); }
  .next-page-title { font-family: var(--pixel-font); font-size: 1.5rem; font-weight: 700; }
  .next-page-sub { color: var(--color-stone-600); font-size: 0.95rem; }
</style>
