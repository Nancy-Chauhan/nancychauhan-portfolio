---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import Features from "../components/home/Features.astro";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
import RecentPosts from "../components/home/RecentPosts.astro";
import Talks from "../components/home/Talks.astro";
import Community from "../components/home/Community.astro";
import Testimonials from "../components/home/Testimonials.astro";
import LogoMarquee from "../components/home/LogoMarquee.astro";
import PhotoGallery from "../components/PhotoGallery.astro";
import { getCollection } from "astro:content";

const featuredProjects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const featuredProjectsSchema = {
  "@type": "ItemList",
  "@id": "https://nancychauhan.com/#featured-projects",
  name: "Featured projects by Nancy Chauhan",
  itemListElement: featuredProjects.map((project, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: `https://nancychauhan.com/projects/${project.id}`,
    name: project.data.title,
  })),
};
---

<BaseLayout
  title="Nancy Chauhan | AI, Security & Open Source Engineer"
  description="Nancy Chauhan is an engineer and product builder creating AI, security, developer tooling, and open-source systems—and sharing practical lessons from shipping them."
  preloadImage="/nancy-speaking-1400.webp"
  structuredData={featuredProjectsSchema}
>
  <Hero />
  <LogoMarquee />
  <div class="homepage-pixel-zone max-w-6xl mx-auto px-6 md:px-24 pb-24">
    <hr class="section-divider mb-16" />
    <Features />
    <hr class="section-divider my-16" />
    <RecentPosts variant="agents" />
    <hr class="section-divider my-16" />
    <FeaturedProjects />
    <hr class="section-divider my-16" />
    <RecentPosts />
    <hr class="section-divider my-16" />
    <Talks limit={3} homepage />
    <hr class="section-divider my-16" />
    <Community />
    <hr class="section-divider my-16" />
    <Testimonials limit={6} />
    <hr class="section-divider my-16" />
    <section id="beyond-work">
      <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-3 animate-on-scroll">
            <span class="section-heading">Beyond Work</span>
          </h2>
          <p class="text-base text-[var(--text-muted)] animate-on-scroll">
            Places, people, art, culture, and the moments I keep coming back to.
          </p>
        </div>
        <a href="https://lens.nancychauhan.com/" target="_blank" rel="noopener noreferrer" class="pixel-button pixel-button-ghost text-sm shrink-0 animate-on-scroll">
          Photos &amp; zines ↗
        </a>
      </div>
      <PhotoGallery />
    </section>
  </div>
</BaseLayout>
